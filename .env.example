# ==========================================
# Al-Bayan Environment Configuration Template
# ==========================================
# Copy this file to .env.local for local development.
# NOTE: .env.local is ignored by git and will never be pushed to your repository.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret keys for future features (e.g., authentication, external paid APIs)
# KEEP PRIVATE - Never prefix secret keys with NEXT_PUBLIC_
APP_SECRET_KEY=your-secret-key-here
# DATABASE_URL=file:./data/quran.db
# EXTERNAL_API_KEY=your-api-key-here
